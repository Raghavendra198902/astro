# Production Environment Variables Template
# Copy this to .env and fill in actual values
# NEVER commit .env files with real values to git!

# ============================================
# ENVIRONMENT
# ============================================
ENVIRONMENT=production
DEBUG=false

# ============================================
# SECRET KEYS (Generate strong random keys)
# ============================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_TO_STRONG_RANDOM_KEY_32_CHARS_MIN
JWT_SECRET_KEY=CHANGE_ME_TO_STRONG_RANDOM_KEY_32_CHARS_MIN

# ============================================
# DATABASE
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=astor_ai
DB_USER=astor_user
# Generate with: openssl rand -base64 24
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD_20_CHARS_MIN

DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# ============================================
# RABBITMQ
# ============================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=astor
RABBITMQ_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/

# ============================================
# AI/LLM API KEYS
# ============================================
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_API_KEY_HERE

# ============================================
# PAYMENT GATEWAYS
# ============================================
# Stripe
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Razorpay
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@astorai.com
SMTP_FROM_NAME=ASTOR AI

# ============================================
# MONITORING & ERROR TRACKING
# ============================================
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/PROJECT_ID

# ============================================
# CLOUD STORAGE (AWS S3)
# ============================================
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_REGION=us-east-1
S3_BUCKET=astor-ai-production

# ============================================
# FRONTEND URLs
# ============================================
FRONTEND_URL=https://astorai.com
API_URL=https://api.astorai.com

# ============================================
# CORS ALLOWED ORIGINS
# ============================================
ALLOWED_ORIGINS=https://astorai.com,https://www.astorai.com

# ============================================
# JWT SETTINGS
# ============================================
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=5

# ============================================
# CELERY
# ============================================
CELERY_BROKER_URL=${RABBITMQ_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# ============================================
# BACKUP SETTINGS
# ============================================
BACKUP_ENABLED=true
BACKUP_S3_ENABLED=true
BACKUP_RETENTION_DAYS=7

# ============================================
# SECURITY SETTINGS
# ============================================
HTTPS_ONLY=true
SECURE_COOKIES=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_WEBSOCKET=true
ENABLE_PREDICTIONS_CACHE=true
ENABLE_AI_INTERPRETATIONS=true

# ============================================
# NOTES
# ============================================
# 1. Never commit this file with real values
# 2. Rotate secrets every 90 days
# 3. Use different values for dev/staging/production
# 4. Store production secrets in a vault (HashiCorp Vault, AWS Secrets Manager)
# 5. Grant minimal access to secrets (principle of least privilege)
