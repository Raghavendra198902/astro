# OAuth Configuration for Google and Microsoft Login
# 
# To enable OAuth login, you need to create OAuth apps and add credentials here:

# Google OAuth (https://console.cloud.google.com)
# 1. Create project → Enable Google+ API
# 2. Credentials → Create OAuth 2.0 Client ID → Web application
# 3. Add redirect URI: http://192.168.0.102/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://192.168.0.102/api/v1/auth/google/callback

# Microsoft OAuth (https://portal.azure.com)
# 1. Azure AD → App registrations → New registration
# 2. Add redirect URI: http://192.168.0.102/api/v1/auth/microsoft/callback
# 3. Certificates & secrets → New client secret
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_REDIRECT_URI=http://192.168.0.102/api/v1/auth/microsoft/callback

# Frontend URL (where to redirect after successful login)
FRONTEND_URL=http://192.168.0.102:3000
