# Utility functions for tests

def assert_valid_uuid(value: str):
    """Assert that a string is a valid UUID"""
    import uuid
    try:
        uuid.UUID(value)
    except ValueError:
        pytest.fail(f"Invalid UUID: {value}")


def assert_datetime_close(dt1: datetime, dt2: datetime, tolerance_seconds: int = 5):
    """Assert that two datetimes are close within tolerance"""
    diff = abs((dt1 - dt2).total_seconds())
    assert diff <= tolerance_seconds, f"Datetimes differ by {diff} seconds"
