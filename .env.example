# ========================================
# Astor AI Environment Configuration
# ========================================

# Environment
ENVIRONMENT=development  # development|staging|production
DEBUG=True

# Database
DATABASE_URL=postgresql://astor_user:astor_pass@localhost:5432/astor_ai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# RabbitMQ
RABBITMQ_URL=amqp://astor:astor_queue@localhost:5672/

# Security
SECRET_KEY=your-super-secret-key-min-32-chars-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# AI Configuration
LLM_PROVIDER=openai  # openai|anthropic|ollama|local
LLM_API_KEY=sk-your-openai-api-key
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60

# RAG Configuration
ENABLE_RAG=True
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_SIMILARITY_THRESHOLD=0.7
RAG_TOP_K=5

# Ephemeris Configuration
EPHEMERIS_PATH=/app/ephemeris/data
EPHEMERIS_CACHE_ENABLED=True
DEFAULT_AYANAMSHA=lahiri  # lahiri|raman|krishnamurti|yukteshwar

# Chart Configuration
DEFAULT_HOUSE_SYSTEM=placidus  # placidus|whole_sign|koch|equal
DEFAULT_ORBS_CONJUNCTION=8
DEFAULT_ORBS_OPPOSITION=8
DEFAULT_ORBS_TRINE=8
DEFAULT_ORBS_SQUARE=7
DEFAULT_ORBS_SEXTILE=6

# Timezone & Geocoding
GEOCODING_PROVIDER=offline  # offline|google|mapbox
GEOCODING_API_KEY=your-geocoding-api-key
TIMEZONE_DATABASE_PATH=/app/data/timezones.db

# Payments
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
PAYMENT_CURRENCY=INR
ENABLE_GST=True
GST_RATE=18

# Plans & Pricing
PLAN_FREE_CHARTS_LIMIT=3
PLAN_FREE_REPORTS_LIMIT=1
PLAN_PRO_MONTHLY_PRICE=999
PLAN_PRO_YEARLY_PRICE=9999
PLAN_ASTROLOGER_MONTHLY_PRICE=2999

# Vision AI (Face & Palm Reading)
ENABLE_VISION_AI=True
VISION_ON_DEVICE_PREFERRED=True
VISION_MODEL_FACE=mediapipe
VISION_MODEL_PALM=mediapipe
BIOMETRIC_RETENTION_DAYS=30
FACE_LANDMARK_COUNT=468

# Numerology
ENABLE_NUMEROLOGY=True
DEFAULT_NUMEROLOGY_SYSTEM=pythagorean  # pythagorean|chaldean

# Reports
REPORT_GENERATOR=weasyprint  # weasyprint|pdfkit
REPORT_DEFAULT_THEME=classic  # classic|minimal|festival
REPORT_STORAGE=s3  # local|s3|minio
REPORT_WATERMARK_ENABLED=True

# S3 / MinIO
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=astor-ai-reports
S3_REGION=us-east-1

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@astorai.com
SMTP_PASSWORD=your-email-password
SMTP_FROM_EMAIL=noreply@astorai.com
SMTP_FROM_NAME=Astor AI

# Consultation
ENABLE_CONSULTATIONS=True
WEBRTC_PROVIDER=agora  # agora|twilio|jitsi
WEBRTC_API_KEY=your-webrtc-api-key
WEBRTC_API_SECRET=your-webrtc-secret

# Monitoring & Observability
ENABLE_TELEMETRY=True
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=astor-ai-backend
ENABLE_METRICS=True
ENABLE_TRACING=True

# Logging
LOG_LEVEL=INFO  # DEBUG|INFO|WARNING|ERROR|CRITICAL
LOG_FORMAT=json  # json|plain
LOG_FILE_PATH=/var/log/astor-ai/app.log

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
SENTRY_TRACES_SAMPLE_RATE=0.1

# Feature Flags
FEATURE_RECTIFICATION=False
FEATURE_MUHURTA=False
FEATURE_MULTILANG=False

# Compliance
ENABLE_AUDIT_LOG=True
ENABLE_DATA_EXPORT=True
GDPR_COMPLIANCE=True
COPPA_COMPLIANCE=True
